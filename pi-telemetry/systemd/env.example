MQTT_BROKER_HOST=192.168.0.181
MQTT_BROKER_PORT=1883
MQTT_BROKER_USERNAME=changeme
MQTT_BROKER_PASSWORD=changeme

# Distinguishes this host from other pi-telemetry hosts: it becomes part of the
# MQTT topics, the MQTT client id and the Home Assistant device name. Must be
# unique per host. If unset, the hostname is used. The repo root's install.sh
# sets this from the device name you pass it -- see its README, not this file,
# when installing via that script.
#DEVICE_ID=my-unit
