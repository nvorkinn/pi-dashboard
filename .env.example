# Transport for London API
TFL__APP_KEY=your_tfl_api_key_here

# OpenWeatherMap API
WEATHER__API_KEY=your_openweathermap_api_key_here

# auth-broker (https://github.com/nvorkinn/auth-broker) handles Spotify OAuth and
# hosts per-device config centrally. Only override this for local dev against a
# broker running on your own machine -- the production default just works.
# BROKER_URL=http://127.0.0.1:5000

# Glowmarkt API
GLOWMARKT__USERNAME=your_glowmarkt_email_here
GLOWMARKT__PASSWORD=your_glowmarkt_password_here
