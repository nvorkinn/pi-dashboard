# auth-broker (https://github.com/nvorkinn/auth-broker) handles Spotify OAuth and
# hosts per-device config centrally -- including the TfL/weather API keys, so
# there's no reason for those to live in this file too (every gifted device
# having its own local copy of a *shared* key would just be needless exposure).
# Only override this for local dev against a broker running on your own machine
# -- the production default just works.
# BROKER_URL=http://127.0.0.1:5000

# Glowmarkt API -- this is the frame owner's own energy account, not something
# auth-broker ever knows about, so it stays local.
GLOWMARKT__USERNAME=your_glowmarkt_email_here
GLOWMARKT__PASSWORD=your_glowmarkt_password_here
