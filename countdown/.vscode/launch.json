{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: uv run main.py --verbose",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--verbose"
            ],
            "cwd": "${workspaceFolder}",
            "python": "${command:python.interpreterPath}",
            "console": "integratedTerminal"
        },
        {
            "name": "Clear Waveshare ePaper Screen",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/display/clear_screen.py",
            "args": [
                "--verbose"
            ],
            "cwd": "${workspaceFolder}",
            "python": "${command:python.interpreterPath}",
            "console": "integratedTerminal"
        }
    ]
}