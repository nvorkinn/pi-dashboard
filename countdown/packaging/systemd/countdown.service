[Unit]
Description=Countdown e-paper display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@WORKING_DIRECTORY@
Environment=BROKER_URL=https://auth.nikolaivorkinn.com
# Otherwise stdout is block-buffered under systemd and output reaches the journal late.
Environment=PYTHONUNBUFFERED=1
# DEVICE_NAME, written by the repo-root install.sh. Optional: without it the hostname is used.
EnvironmentFile=-/etc/countdown/env
# Encrypts .auth_broker_device (countdown_credentials/credentials_key.py). Root's, so the file never sits next to its key;
# systemd hands it to the service under $CREDENTIALS_DIRECTORY. Made by install.sh.
LoadCredential=credentials-key:/etc/pi-setup/credentials-key
# Once registered, countdown writes its credentials here for Fluent Bit (countdown_credentials/log_shipping.py). In
# /run, which is RAM, so the secret is never on the SD card; kept when countdown stops, so Fluent Bit isn't cut off.
RuntimeDirectory=countdown
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Environment=FLUENT_BIT_ENV_FILE=/run/countdown/fluent-bit-env
ExecStart=@EXEC_START@
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
