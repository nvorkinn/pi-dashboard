[Unit]
Description=Countdown e-paper display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@WORKING_DIRECTORY@
Environment=BROKER_URL=https://auth.nikolaivorkinn.com
# Otherwise stdout is block-buffered under systemd and output reaches the journal late.
Environment=PYTHONUNBUFFERED=1
# Shared with pi-telemetry. Optional: without it health reporting to Home Assistant is off.
EnvironmentFile=-/etc/pi-telemetry/env
ExecStart=@EXEC_START@
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
