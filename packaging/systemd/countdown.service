[Unit]
Description=Countdown e-paper display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@WORKING_DIRECTORY@
Environment=BROKER_URL=https://auth.nikolaivorkinn.com
# Without this stdout is block-buffered under systemd, so the app's own log lines
# (every print(), including the MQTT and API errors) never reach the journal.
Environment=PYTHONUNBUFFERED=1
# Shared with pi-telemetry (MQTT_BROKER_HOST etc, DEVICE_ID). Optional: without it
# there's no MQTT host, so health reporting to Home Assistant is simply off.
EnvironmentFile=-/etc/pi-telemetry/env
ExecStart=@EXEC_START@
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
