[Unit]
Description=Countdown e-paper display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@WORKING_DIRECTORY@
Environment=BROKER_URL=https://auth.nikolaivorkinn.com
ExecStart=@EXEC_START@
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
